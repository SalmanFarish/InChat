{
  "name": "inchat-database-rules-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "npx --yes firebase-tools@latest emulators:exec --only database --project demo-inchat-rules --config ../../firebase.json \"node --test rules.test.mjs\"",
    "emulators": "npx --yes firebase-tools@latest emulators:start --only auth,database --project demo-inchat-rules --config ../../firebase.json",
    "olm-relay-emulator": "npx --yes firebase-tools@latest emulators:start --only database --project demo-inchat-olm-relay --config ../../firebase.olm-relay-emulator.json"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.3.0"
  }
}
